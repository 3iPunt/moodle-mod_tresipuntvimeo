{{!
    @template mod_videoconnect/index_page

    List of every Video Connect instance of one course.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * firstcolumn: string - Header of the first column (section / last modified).
    * rows: array - One entry per instance:
        * sectionlabel: string - Section name or formatted date, may be empty.
        * viewurl: string - URL of the activity view page.
        * name: string - Formatted activity name.
        * intro: string - Formatted intro HTML.
        * dimmed: boolean - Whether the activity is hidden from students.

    Example context (json):
    {
        "firstcolumn": "Section",
        "rows": [
            {"sectionlabel": "Topic 1", "viewurl": "#", "name": "My video",
             "intro": "<p>Intro</p>", "dimmed": false}
        ]
    }
}}
<table class="generaltable mod_index">
    <thead>
        <tr>
            <th scope="col">{{firstcolumn}}</th>
            <th scope="col">{{#str}} name {{/str}}</th>
            <th scope="col">{{#str}} moduleintro {{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#rows}}
        <tr>
            <td>{{sectionlabel}}</td>
            <td><a href="{{viewurl}}" {{#dimmed}}class="dimmed"{{/dimmed}}>{{name}}</a></td>
            <td>{{{intro}}}</td>
        </tr>
        {{/rows}}
    </tbody>
</table>
