{{!
    @template mod_videoconnect/detail_page

    Upload attempts detail of one Video Connect activity.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-region="mod_videoconnect-detail"

    Context variables required for this template:
    * name: string - Activity name.
    * coursename: string - Course full name.
    * courseurl: string - URL of the course.
    * activityurl: string - URL of the activity view page.
    * statelabel: string - Derived state label.
    * hasvideo: boolean - Whether the activity has a published video.
    * idvideo: string - Vimeo video ID.
    * videourl: string - URL of the video on Vimeo.
    * backurl: string - URL back to the panel list.
    * hasattempts: boolean - Whether there are upload attempts.
    * attempts: array - Upload attempts, newest first.
        * timecreated: string - Formatted creation time.
        * timeuploaded: string - Formatted upload time or '-'.
        * statuslabel: string - Status label.
        * badgeclass: string - CSS class of the status badge.
        * httperror: string - HTTP error detail, may be empty.
        * fileavailable: boolean - Whether the temp file still exists.

    Example context (json):
    {
        "name": "My video",
        "coursename": "My course",
        "courseurl": "#",
        "activityurl": "#",
        "statelabel": "Upload error",
        "hasvideo": false,
        "idvideo": "",
        "videourl": "",
        "backurl": "#",
        "hasattempts": true,
        "attempts": [
            {"timecreated": "5/06/26 17:18", "timeuploaded": "-", "statuslabel": "Upload failed",
             "badgeclass": "badge text-bg-danger", "httperror": "Unable to initiate an upload (3000)", "fileavailable": true}
        ]
    }
}}
<div data-region="mod_videoconnect-detail">
    <div class="mb-3">
        <a href="{{backurl}}" class="btn btn-secondary mb-3">&larr; {{# str }} backtopanel, mod_videoconnect {{/ str }}</a>
        <h3><a href="{{activityurl}}">{{name}}</a></h3>
        <p class="mb-1">
            {{# str }} course {{/ str }}: <a href="{{courseurl}}">{{coursename}}</a>
            &middot; {{# str }} videostate, mod_videoconnect {{/ str }}: <strong>{{statelabel}}</strong>
            {{#hasvideo}}
            &middot; {{# str }} idvideo, mod_videoconnect {{/ str }}:
            <a href="{{videourl}}" target="_blank" rel="noopener">{{idvideo}}</a>
            {{/hasvideo}}
        </p>
    </div>
    <h4>{{# str }} uploadattempts, mod_videoconnect {{/ str }}</h4>
    {{#hasattempts}}
    <table class="generaltable">
        <thead>
            <tr>
                <th>{{# str }} date {{/ str }}</th>
                <th>{{# str }} status {{/ str }}</th>
                <th>{{# str }} errordetail, mod_videoconnect {{/ str }}</th>
                <th>{{# str }} uploaddate, mod_videoconnect {{/ str }}</th>
                <th>{{# str }} fileavailable, mod_videoconnect {{/ str }}</th>
                <th>{{# str }} actions {{/ str }}</th>
            </tr>
        </thead>
        <tbody>
            {{#attempts}}
            <tr>
                <td>{{timecreated}}</td>
                <td><span class="{{badgeclass}}">{{statuslabel}}</span></td>
                <td>{{#httperror}}{{httperror}}{{/httperror}}{{^httperror}}-{{/httperror}}</td>
                <td>{{timeuploaded}}</td>
                <td>{{#fileavailable}}{{# str }} yes {{/ str }}{{/fileavailable}}{{^fileavailable}}{{# str }} no {{/ str }}{{/fileavailable}}</td>
                <td>
                    {{#canretry}}
                    <a href="{{retryurl}}" class="btn btn-sm btn-primary">{{# str }} retry, mod_videoconnect {{/ str }}</a>
                    {{/canretry}}
                    {{#candiscard}}
                    <a href="{{discardurl}}" class="btn btn-sm btn-outline-danger">{{# str }} discard, mod_videoconnect {{/ str }}</a>
                    {{/candiscard}}
                    {{#notrecoverable}}
                    <span class="text-muted small">{{# str }} notrecoverable, mod_videoconnect {{/ str }}</span>
                    {{/notrecoverable}}
                    {{^canretry}}{{^candiscard}}{{^notrecoverable}}-{{/notrecoverable}}{{/candiscard}}{{/canretry}}
                </td>
            </tr>
            {{/attempts}}
        </tbody>
    </table>
    {{/hasattempts}}
    {{^hasattempts}}
    <p class="text-muted">{{# str }} noattempts, mod_videoconnect {{/ str }}</p>
    {{/hasattempts}}
</div>