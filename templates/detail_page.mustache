{{!
    @template mod_videoconnect/detail_page

    Upload attempts detail of one Video Connect activity: co-branded header
    with the activity data, diagnosis card and attempts history.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-region="mod_videoconnect-detail"

    Context variables required for this template:
    * logotresipunt, logoprovider, providername: strings - Header logos.
    * backurl: string - URL back to the panel list.
    * name: string - Activity name. activityurl: string - Its view page.
    * coursename, courseurl: string - Course of the activity.
    * badge: object - State badge (label, icon, tone, spin).
    * hasvideo: boolean. idvideo: string. videourl: string.
    * hasdiag: boolean. diag: object - Diagnosis card (tone, icon, spin, title, body).
    * hasattempts: boolean. noattemptsnote: string.
    * attempts: array - Upload attempts, newest first:
        * timecreated, timeuploaded: string - Formatted times.
        * badge: object - Status badge (label, icon, tone, spin).
        * note: string - Human detail of the attempt.
        * fileavailable, canretry, candiscard, notrecoverable, noactions: boolean.
        * retryurl, discardurl: string - Action URLs (with sesskey).

    Example context (json):
    {
        "logotresipunt": "#", "logoprovider": "#", "providername": "Vimeo",
        "backurl": "#",
        "name": "My video", "activityurl": "#",
        "coursename": "My course", "courseurl": "#",
        "badge": {"label": "Upload error", "icon": "fa-circle-xmark", "tone": "danger", "spin": false},
        "hasvideo": false, "idvideo": "", "videourl": "",
        "hasdiag": true,
        "diag": {"tone": "warning", "icon": "fa-triangle-exclamation", "spin": false,
                 "title": "The upload failed, but you can retry it",
                 "body": "The temporary file is kept, so you can retry from here."},
        "hasattempts": true, "noattemptsnote": "",
        "attempts": [{"timecreated": "5/06/26 17:18", "timeuploaded": "—",
                      "badge": {"label": "Upload failed", "icon": "fa-triangle-exclamation", "tone": "danger", "spin": false},
                      "note": "Unable to initiate an upload (3000)",
                      "fileavailable": true, "canretry": true, "candiscard": true,
                      "notrecoverable": false, "noactions": false,
                      "retryurl": "#", "discardurl": "#"}]
    }
}}
<div data-region="mod_videoconnect-detail" class="mod_videoconnect-panel">
    <a href="{{backurl}}" class="vc-back">
        <i class="fa fa-arrow-left" aria-hidden="true"></i> {{#str}} backtopanel, mod_videoconnect {{/str}}
    </a>

    <div class="vc-header">
        <div class="vc-header-brand">
            <img src="{{logotresipunt}}" alt="Tresipunt" class="vc-header-logo">
            <span class="vc-header-divider" aria-hidden="true"></span>
            <img src="{{logoprovider}}" alt="{{#str}} provideralt, mod_videoconnect, {{providername}} {{/str}}" class="vc-header-logo">
        </div>
        <div class="vc-header-text">
            <h1 class="vc-header-title">
                <a href="{{activityurl}}">{{name}}
                    <i class="fa fa-up-right-from-square vc-header-extlink" aria-hidden="true"></i></a>
            </h1>
            <div class="vc-header-meta">
                <a href="{{courseurl}}" class="text-muted">
                    <i class="fa fa-book" aria-hidden="true"></i> {{coursename}}
                </a>
                <span class="vc-meta-dot" aria-hidden="true"></span>
                {{#badge}}
                <span class="vc-badge vc-badge-{{tone}}">
                    <i class="fa {{icon}} {{#spin}}fa-spin{{/spin}}" aria-hidden="true"></i>{{label}}
                </span>
                {{/badge}}
                <span class="vc-meta-dot" aria-hidden="true"></span>
                {{#hasvideo}}
                <a href="{{videourl}}" target="_blank" rel="noopener" class="vc-link">
                    {{#str}} providervideo, mod_videoconnect {{/str}} · {{idvideo}}
                    <i class="fa fa-up-right-from-square" aria-hidden="true"></i>
                </a>
                {{/hasvideo}}
                {{^hasvideo}}
                <span class="text-muted">{{#str}} novideoid, mod_videoconnect {{/str}}</span>
                {{/hasvideo}}
            </div>
        </div>
    </div>

    {{#hasdiag}}
    {{#diag}}
    <div class="vc-diag vc-diag-{{tone}}" role="status">
        <i class="fa {{icon}} {{#spin}}fa-spin{{/spin}}" aria-hidden="true"></i>
        <div>
            <strong class="vc-diag-title">{{title}}</strong>
            <p class="vc-diag-body">{{body}}</p>
        </div>
    </div>
    {{/diag}}
    {{/hasdiag}}

    <h2 class="vc-section-title">
        <i class="fa fa-film" aria-hidden="true"></i> {{#str}} uploadattempts, mod_videoconnect {{/str}}
    </h2>

    {{#hasattempts}}
    <div class="card vc-table-card">
        <div class="card-body">
            <table class="generaltable vc-attempts-table">
                <caption class="sr-only visually-hidden">{{#str}} uploadattempts, mod_videoconnect {{/str}}</caption>
                <thead>
                    <tr>
                        <th scope="col">{{#str}} date {{/str}}</th>
                        <th scope="col">{{#str}} status {{/str}}</th>
                        <th scope="col">{{#str}} errordetail, mod_videoconnect {{/str}}</th>
                        <th scope="col">{{#str}} uploaddate, mod_videoconnect {{/str}}</th>
                        <th scope="col">{{#str}} fileavailable, mod_videoconnect {{/str}}</th>
                        <th scope="col">{{#str}} actions {{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#attempts}}
                    <tr>
                        <td>{{timecreated}}</td>
                        <td>
                            {{#badge}}
                            <span class="vc-badge vc-badge-{{tone}}">
                                <i class="fa {{icon}} {{#spin}}fa-spin{{/spin}}" aria-hidden="true"></i>{{label}}
                            </span>
                            {{/badge}}
                        </td>
                        <td class="vc-attempt-note" title="{{note}}">{{note}}</td>
                        <td>{{timeuploaded}}</td>
                        <td>
                            {{#fileavailable}}
                            <span class="vc-file vc-tone-success"><i class="fa fa-check" aria-hidden="true"></i> {{#str}} yes {{/str}}</span>
                            {{/fileavailable}}
                            {{^fileavailable}}
                            <span class="vc-file text-muted"><i class="fa fa-xmark" aria-hidden="true"></i> {{#str}} no {{/str}}</span>
                            {{/fileavailable}}
                        </td>
                        <td class="vc-attempt-actions">
                            {{#canretry}}
                            <a href="{{retryurl}}" class="btn btn-primary btn-sm vc-btn-icon">
                                <i class="fa fa-rotate" aria-hidden="true"></i> {{#str}} retry, mod_videoconnect {{/str}}
                            </a>
                            {{/canretry}}
                            {{#candiscard}}
                            <a href="{{discardurl}}" class="btn btn-outline-danger btn-sm vc-btn-icon">
                                <i class="fa fa-xmark" aria-hidden="true"></i> {{#str}} discard, mod_videoconnect {{/str}}
                            </a>
                            {{/candiscard}}
                            {{#notrecoverable}}
                            <span class="text-muted small">
                                <i class="fa fa-minus" aria-hidden="true"></i> {{#str}} notrecoverable_label, mod_videoconnect {{/str}}
                            </span>
                            {{/notrecoverable}}
                            {{#noactions}}<span class="text-muted">—</span>{{/noactions}}
                        </td>
                    </tr>
                    {{/attempts}}
                </tbody>
            </table>
        </div>
    </div>
    {{/hasattempts}}
    {{^hasattempts}}
    <div class="vc-empty vc-empty-dashed">
        <span class="vc-empty-icon vc-tone-neutral" aria-hidden="true"><i class="fa fa-film"></i></span>
        <p class="vc-empty-sub">{{noattemptsnote}}</p>
    </div>
    {{/hasattempts}}
</div>
